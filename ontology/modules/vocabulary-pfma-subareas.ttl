@prefix iao:     <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix :        <https://w3id.org/gcdfo/salmon/modules/pfma-subarea-vocabulary#> .

<https://w3id.org/gcdfo/salmon/modules/pfma-subarea-vocabulary> a owl:Ontology ;
  dcterms:title "DFO Salmon Ontology vocabulary module: Pacific fishery management Subareas"@en ;
  dcterms:description "The 604 Pacific fishery management Subareas prescribed by paragraph (b) of the 48 items of Schedule 2 to the Pacific Fishery Management Area Regulations, 2007 (SOR/2007-77), as a SKOS concept scheme."@en ;
  rdfs:comment "A vocabulary module, not an alignment overlay: it declares the members of one controlled vocabulary and asserts nothing about how terms relate. The class these concepts are values of — gcdfo:PacificFisheryManagementSubarea — is core schema and is declared in https://w3id.org/gcdfo/salmon, which this module imports. Authoritative term governance stays there; only the enumeration lives here."@en ;
  rdfs:comment "Why this is a separate file. The 48 parent Areas are core content, and at 48 members that is navigable. 604 Subareas are not: held in core they added 10,305 lines to ontology/dfo-salmon.ttl and 98,685 to the generated WebVOWL graph, which is a diagram no reader can use. Splitting the enumeration out keeps the human-facing artifacts navigable without changing a single concept. See docs/adr/009-pfma-subarea-scheme-separation.md."@en ;
  rdfs:seeAlso <https://github.com/dfo-pacific-science/dfo-salmon-ontology> ;
  owl:imports <https://w3id.org/gcdfo/salmon> .

#################################################################
# SKOS Pacific Fishery Management Subareas (SOR/2007-77 Schedule 2)
#################################################################

gcdfo:PacificFisheryManagementSubareaScheme a skos:ConceptScheme ;
  skos:prefLabel "Pacific Fishery Management Subarea Scheme"@en ;
  skos:altLabel "PFMA Subarea Scheme"@en ;
  skos:definition "Controlled vocabulary of the 604 Subareas into which Schedule 2 to the Pacific Fishery Management Area Regulations, 2007 (SOR/2007-77) subdivides the prescribed Pacific fishery management areas. Section 1 of those Regulations defines a Subarea as a subdivision of a management area. Each member is a value of the Pacific fishery management subarea class in this ontology, and carries skos:broader to its parent Area in the Pacific Fishery Management Area Scheme."@en ;
  skos:scopeNote "The vocabulary is complete: it contains every Subarea named in paragraph (b) of the 48 items of Schedule 2 — 604 in total, distributed over 42 Areas. The remaining six Areas (21, 22, 103, 109, 110 and 111) are not subdivided by the Regulations and so contribute no Subarea; that is the instrument's own silence, not a gap in this vocabulary."@en ;
  skos:scopeNote "Subarea numbers are contiguous from 1 within their Area in every case but one: Area 2 runs 2-1 to 2-19 and then 2-31 to 2-100, with no Subarea 2-20 to 2-30. Contiguity therefore cannot be used as a completeness test here, unlike the Area list, whose Schedule 2 item numbers do run 1 to 48 without a gap."@en ;
  skos:scopeNote "Unlike the Area list, this one has no second published DFO listing to check it against. Fisheries and Oceans Canada's Pacific fishery management area pages carry maps only and refer the reader back to these Regulations for the written Subarea descriptions, and DFO's Pacific Fishery Management Areas map service no longer resolves. The extraction was instead checked against two further renderings of the same instrument: the Justice Laws HTML consolidation of Schedule 2, and the French consolidation (ANNEXE 2), which enumerates the identical 604 sous-secteurs under the identical 48 secteurs. Retrieved 2026-08-25."@en ;
  skos:scopeNote "Schedule 2 delimits each Subarea by a textual description of coordinates, parallels, meridians and shorelines. No geometry is encoded here: these concepts identify and label Subareas, they do not delimit them. Use the Regulations, or a DFO spatial dataset, for boundaries."@en ;
  rdfs:seeAlso gcdfo:PacificFisheryManagementAreaScheme ;
  iao:0000119 "Government of Canada. Pacific Fishery Management Area Regulations, 2007 (SOR/2007-77), Schedule 2 (Management Area Boundary Descriptions), paragraph (b) of each item. Consolidation current to 2026-06-21, last amended 2017-04-13; retrieved 2026-08-25."@en ;
  iao:0000119 "Government of Canada. Règlement de 2007 sur les secteurs de pêche du Pacifique (DORS/2007-77), ANNEXE 2. Retrieved 2026-08-25. Used as an independent rendering of the same instrument to confirm the Subarea count."@en ;
  dcterms:source <https://laws-lois.justice.gc.ca/eng/regulations/sor-2007-77/page-3.html>,
    <https://laws-lois.justice.gc.ca/fra/reglements/DORS-2007-77/page-3.html> ;
  gcdfo:theme gcdfo:FisheriesManagementTheme, gcdfo:StockAssessmentTheme, gcdfo:PolicyGovernanceTheme ;
  rdfs:isDefinedBy <https://w3id.org/gcdfo/salmon> .

gcdfo:PacificFisheryManagementSubarea1-1 a gcdfo:PacificFisheryManagementSubarea , skos:Concept ;
  skos:prefLabel "Pacific fishery management subarea 1-1"@en ;
  rdfs:label "Pacific fishery management subarea 1-1"@en ;
  skos:altLabel "Subarea 1-1"@en ;
  skos:altLabel "PFMA Subarea 1-1"@en ;
  skos:notation "1-1" ;
  skos:definition "The subdivision of Canadian fisheries waters prescribed as Subarea 1-1 of Pacific fishery management Area 1, within the boundary described in paragraph (b) of item 1 of Schedule 2 to the Pacific Fishery Management Area Regulations, 2007."@en ;
  skos:scopeNote "Subarea 1-1 subdivides Pacific fishery management Area 1, which Fisheries and Oceans Canada's published area listing describes as Northern Haida Gwaii."@en ;
  skos:broader gcdfo:PacificFisheryManagementArea1 ;
  skos:inScheme gcdfo:PacificFisheryManagementSubareaScheme ;
  iao:0000119 "Government of Canada. Pacific Fishery Management Area Regulations, 2007 (SOR/2007-77), Schedule 2, item 1, paragraph (b) (Subarea 1-1). Consolidation current to 2026-06-21, last amended 2017-04-13; retrieved 2026-08-25."@en ;
  iao:0000119 "Fisheries and Oceans Canada. Maps of Pacific Fishery Management Areas (area listing, page modified 2021-12-08); retrieved 2026-08-25. Used for the parent Area's published locality description."@en ;
  dcterms:source <https://laws-lois.justice.gc.ca/eng/regulations/sor-2007-77/page-3.html>,
    <https://www.pac.dfo-mpo.gc.ca/fm-gp/maps-cartes/areas-secteurs/index-eng.html> ;
  gcdfo:theme gcdfo:FisheriesManagementTheme, gcdfo:StockAssessmentTheme, gcdfo:PolicyGovernanceTheme ;
  rdfs:isDefinedBy <https://w3id.org/gcdfo/salmon> .

