  rdfs:label "Pacific fishery management subarea 13-35"@en ;
  skos:altLabel "Subarea 13-35"@en ;
  skos:altLabel "PFMA Subarea 13-35"@en ;
  skos:notation "13-35" ;
  skos:definition "The subdivision of Canadian fisheries waters prescribed as Subarea 13-35 of Pacific fishery management Area 13, comprising those waters of Sunderland Channel and Johnstone Strait, within the boundary described in paragraph (b) of item 13 of Schedule 2 to the Pacific Fishery Management Area Regulations, 2007."@en ;
  skos:scopeNote "Subarea 13-35 subdivides Pacific fishery management Area 13, which Fisheries and Oceans Canada's published area listing describes as Quadra Island, Cortes Island."@en ;
  skos:broader gcdfo:PacificFisheryManagementArea13 ;
  skos:inScheme gcdfo:PacificFisheryManagementSubareaScheme ;
  iao:0000119 "Government of Canada. Pacific Fishery Management Area Regulations, 2007 (SOR/2007-77), Schedule 2, item 13, paragraph (b) (Subarea 13-35). Consolidation current to 2026-06-21, last amended 2017-04-13; retrieved 2026-08-25."@en ;
  iao:0000119 "Fisheries and Oceans Canada. Maps of Pacific Fishery Management Areas (area listing, page modified 2021-12-08); retrieved 2026-08-25. Used for the parent Area's published locality description."@en ;
  dcterms:source <https://laws-lois.justice.gc.ca/eng/regulations/sor-2007-77/page-3.html>,
    <https://www.pac.dfo-mpo.gc.ca/fm-gp/maps-cartes/areas-secteurs/index-eng.html> ;
  gcdfo:theme gcdfo:FisheriesManagementTheme, gcdfo:StockAssessmentTheme, gcdfo:PolicyGovernanceTheme ;
  rdfs:isDefinedBy <https://w3id.org/gcdfo/salmon> .

