@prefix gcdfo:    <https://w3id.org/gcdfo/salmon#> .
@prefix smn:      <https://w3id.org/smn/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix dwc:      <http://rs.tdwg.org/dwc/terms/> .
@prefix ro:       <http://purl.obolibrary.org/obo/RO_> .
@prefix :         <https://w3id.org/gcdfo/salmon/modules/alignment-main#> .

: a owl:Ontology ;
  rdfs:label "DFO Salmon Ontology Alignment Module (main-candidate)"@en ;
  rdfs:comment "Conservative upper-level alignment bridges derived from SOSA/I-ADOPT/DwC crosswalk workbooks (files 74, 75, 76, 77). Intended for near-term merge safety."@en ;
  owl:imports <https://w3id.org/gcdfo/salmon> .

#################################################################
# Conservative class bridges (annotation-level)
#
# Subjects retargeted to smn: 2026-08-16 (ADR-007). The gcdfo: twins of
# these terms were retired when the core ontology migrated overlapping
# shared terms to smn: IRIs directly (dfo-salmon.ttl migration note,
# 2026-03-15); the bridges kept pointing at the retired gcdfo: names.
# gcdfo: subjects below are the terms DFO still owns and declares.
#
# Why skos:closeMatch on terms that are OWL classes, and not
# rdfs:subClassOf / owl:equivalentClass: closeMatch is the shared layer's
# own cross-framework idiom, not a slip. The imported smn closure asserts
# 18 such class-to-class matches before this overlay is loaded — seven of
# them the very rows below, verbatim — and smn deliberately *demoted* a
# sosa:Sampling superclass claim to skos:closeMatch (alignment finding F7,
# mirrored in dfo-salmon.ttl). Promoting these to entailment-bearing OWL
# axioms would assert equivalences nobody has confirmed, in the file whose
# stated job is to avoid brittle equivalence axioms, and would contradict
# an upstream decision. Promote a row only when the pairing is confirmed
# AND the shared layer makes the same claim in OWL; that is the condition
# under which this note stops applying. Measured evidence: ADR-007.
#################################################################

smn:SurveyEvent skos:closeMatch <http://www.w3.org/ns/sosa/Sampling> .
smn:EscapementSurveyEvent skos:closeMatch <http://www.w3.org/ns/sosa/Sampling> .
smn:EscapementEstimate skos:closeMatch <http://www.w3.org/ns/sosa/Result> . # was gcdfo:EscapementMeasurement; renamed upstream (SSSOM exactMatch)

smn:ReportingOrManagementStratum skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .
smn:Stock skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .
gcdfo:ConservationUnit skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .
gcdfo:StockManagementUnit skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .
smn:IndicatorRiver skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> .

smn:ReferencePoint skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .
gcdfo:LowerBiologicalBenchmark skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .
gcdfo:FisheriesReferencePointLower skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .

#################################################################
# Safe property reuse links
#################################################################

smn:hasDeme rdfs:subPropertyOf ro:0002351 .
smn:hasPopulation rdfs:subPropertyOf ro:0002351 .
gcdfo:hasConservationUnit rdfs:subPropertyOf ro:0002351 .

#################################################################
# Representation-level bridges (annotation only)
#################################################################

<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdfs:subPropertyOf prov:used .
<http://www.w3.org/ns/sosa/hasResult> rdfs:subPropertyOf prov:generated .
<http://www.w3.org/ns/sosa/isSampleOf> rdfs:subPropertyOf prov:wasDerivedFrom .

<http://www.w3.org/ns/sosa/Property> skos:closeMatch <https://w3id.org/iadopt/ont/Property> .
<https://w3id.org/iadopt/ont/Variable> skos:closeMatch <http://www.w3.org/ns/sosa/Property> .

# broadMatch, not closeMatch: dwc:Event is broader than sosa:Sampling. Mirrors
# the shared layer, which asserts skos:broadMatch here. Asserting closeMatch put
# two different mapping strengths on one pair in every core+overlay merge
# (caught by `make check-modules`, 2026-08-16).
<http://www.w3.org/ns/sosa/Sampling> skos:broadMatch dwc:Event .
<http://www.w3.org/ns/sosa/Sample> skos:closeMatch dwc:MaterialEntity .
<http://www.w3.org/ns/sosa/Observation> skos:closeMatch dwc:Occurrence .
<http://www.w3.org/ns/sosa/Procedure> skos:closeMatch <https://rs.tdwg.org/dwc/dp/terms/Protocol> .
